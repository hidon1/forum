rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Helper function to check if user is post/comment author
    function isAuthor(resource) {
      return isSignedIn() && (
        resource.data.Email == request.auth.token.email ||
        resource.data.Username == request.auth.token.email.split('@')[0]
      );
    }
    
    // Users collection
    // Anyone can read user profiles
    // Only the user themselves can write/update their own profile
    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.uid;
      allow update, delete: if isOwner(userId);
    }
    
    // Posts collection (includes both posts and replies)
    // Anyone can read posts
    // Authenticated users can create posts
    // Only authors can update their own posts
    // Only authors can delete their own posts
    match /posts/{postId} {
      allow read: if true;
      
      // Anyone authenticated can create a post
      allow create: if isSignedIn();
      
      // Only allow updates to increment likes or if user is the author
      allow update: if isSignedIn() && (
        // Allow like updates (only incrementing Likes field)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['Likes']) &&
         request.resource.data.Likes > resource.data.Likes) ||
        // Allow author to update their own post
        isAuthor(resource)
      );
      
      // Only author can delete
      allow delete: if isAuthor(resource);
    }
    
    // Contacts collection
    // Anyone can submit a contact form (create)
    // No one can read (only admins through console)
    // No updates or deletes allowed
    match /contacts/{contactId} {
      allow read: if false; // Only accessible through Firebase Console by admins
      allow create: if true;
      allow update, delete: if false;
    }
  }
}
