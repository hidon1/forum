rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper function to check if user is post/comment author
    // Uses UserId field for secure authorship verification
    function isAuthor(resource) {
      return isSignedIn() && (
        // Primary check: UserId matches authenticated user's uid
        resource.data.UserId == request.auth.uid ||
        // Fallback for legacy posts without UserId: check email
        (resource.data.UserId == null && resource.data.Email == request.auth.token.email)
      );
    }
    
    // Users collection
    // Anyone can read user profiles
    // Only the user themselves can write/update their own profile
    // Document ID must match the user's UID
    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update, delete: if isSignedIn() && request.auth.uid == userId;
    }
    
    // Posts collection (includes both posts and replies)
    // Anyone can read posts
    // Authenticated users can create posts
    // Only authors can update their own posts
    // Only authors can delete their own posts
    match /posts/{postId} {
      allow read: if true;
      
      // Anyone authenticated can create a post
      allow create: if isSignedIn();
      
      // Only allow updates to increment likes or if user is the author
      allow update: if isSignedIn() && (
        // Allow like updates (only incrementing Likes field)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['Likes']) &&
         request.resource.data.Likes > resource.data.Likes) ||
        // Allow author to update their own post
        isAuthor(resource)
      );
      
      // Only author can delete
      allow delete: if isAuthor(resource);
    }
    
    // Contacts collection
    // Anyone can submit a contact form (create)
    // No one can read (only admins through console)
    // No updates or deletes allowed
    match /contacts/{contactId} {
      allow read: if false; // Only accessible through Firebase Console by admins
      allow create: if true;
      allow update, delete: if false;
    }
  }
}
